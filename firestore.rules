rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- helpers ---------- */
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isStaffUp() {
      return isSignedIn() && myRole() in ["staff", "admin", "superadmin"];
    }

    function isAdminUp() {
      return isSignedIn() && myRole() in ["admin", "superadmin"];
    }

    function isSuperAdmin() {
      return isSignedIn() && myRole() == "superadmin";
    }

    /* ---------- users ---------- */
    match /users/{userId} {
      allow read: if isOwner(userId) || isStaffUp();

      allow create: if isOwner(userId)
                    && request.resource.data.role == "user";

      // Super Admins edit anything. A user edits their own profile, but can't
      // change their role or lift their own suspension (the real block is
      // the Firebase Auth "disabled" flag, set only by api/manage-user.js).
      allow update: if isSuperAdmin()
                    || (isOwner(userId)
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.get("disabled", false)
                           == resource.data.get("disabled", false));

      allow delete: if false;
    }

    /* ---------- returns and refunds ---------- */
    // A customer asks to return items from a delivered order; staff approve
    // or reject, an admin issues the refund. Everything is written by
    // api/manage-return.js (Admin SDK); the customer reads their own, staff
    // read all.
    match /returns/{returnId} {
      allow read: if isSignedIn()
                  && (resource.data.userId == request.auth.uid || isStaffUp());
      allow write: if false;
    }

    /* ---------- audit trail ---------- */
    // Who changed what, and when. Server functions write most entries (Admin
    // SDK); product changes are written from the admin page, so an admin may
    // add a product entry under their own name, stamped with the server time.
    // Nobody can edit or delete an entry. Admins and Super Admins can read.
    match /auditLogs/{logId} {
      allow read: if isAdminUp();
      allow create: if isAdminUp()
                    && request.resource.data.actorId == request.auth.uid
                    && request.resource.data.targetType == "product"
                    && request.resource.data.at == request.time
                    && request.resource.data.keys().hasOnly([
                         "at", "actorId", "actorName", "actorEmail", "actorRole", "action",
                         "targetType", "targetId", "targetLabel", "summary", "details"
                       ]);
      allow update, delete: if false;
    }

    /* ---------- editable content (Admin > Content / Promotions) ---------- */
    // Pages, the announcement bar, homepage text/banners/featured products
    // are public to read; promo codes can be looked up one at a time (to
    // validate a code a customer typed) but only staff can list them.
    // All writes go through api/manage-content.js (Admin SDK).
    match /pages/{slug} {
      allow read: if true;
      allow write: if false;
    }
    match /content/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /promos/{code} {
      allow get: if true;
      allow list: if isStaffUp();
      allow write: if false;
    }

    /* ---------- store settings ---------- */
    // Shipping fee and payment options: public to read (the store and the
    // apps show them), written only by api/save-settings.js (Admin SDK).
    match /settings/{docId} {
      allow read: if true;
      allow write: if false;
    }

    /* ---------- products ---------- */
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdminUp();
    }

    /* ---------- orders ---------- */
    match /orders/{orderId} {
      allow read: if isSignedIn()
                  && (resource.data.userId == request.auth.uid || isStaffUp());

      // A/D/E: orders are created only by the server (api/place-order.js,
      // Admin SDK), which prices them from the product records, applies
      // promo codes, requires a verified email and starts online orders as
      // "pending". Clients can't create orders directly, so totals can't
      // be tampered with.
      allow create: if false;

      // Orders change only through the server (api/update-order.js): it
      // enforces the status order, the payment checks and puts stock back
      // on cancel. Clients can't edit them directly.
      allow update: if false;

      allow delete: if false;
    }

    /* ---------- reviews ---------- */
    match /reviews/{reviewId} {
      allow read: if true;

      // B: rating 1-5, text <= 1000 chars, photo capped.
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && (!("text" in request.resource.data)
                        || (request.resource.data.text is string
                            && request.resource.data.text.size() <= 1000))
                    && (!("photoBase64" in request.resource.data)
                        || (request.resource.data.photoBase64 is string
                            && request.resource.data.photoBase64.size() <= 700000));

      allow update, delete: if false;
    }

    /* ---------- contactMessages ----------
       Written only by api/contact.js (Admin SDK) from the Contact Us form.
       Staff read them in Admin → Messages and may only flip read status;
       admins may delete. */
    match /contactMessages/{messageId} {
      allow read: if isStaffUp();
      allow update: if isStaffUp()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(["read", "readAt", "readBy"]);
      allow delete: if isAdminUp();
      allow create: if false;
    }
  }
}
