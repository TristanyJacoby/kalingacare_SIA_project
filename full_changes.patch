diff --git a/firestore.rules b/firestore.rules
new file mode 100644
index 0000000..44719b5
--- /dev/null
+++ b/firestore.rules
@@ -0,0 +1,87 @@
+rules_version = '2';
+service cloud.firestore {
+  match /databases/{database}/documents {
+
+    /* ---------- helpers ---------- */
+    function isSignedIn() {
+      return request.auth != null;
+    }
+
+    function isOwner(userId) {
+      return isSignedIn() && request.auth.uid == userId;
+    }
+
+    // Looks up the CALLER's own role from their /users/{uid} doc.
+    // Used everywhere below instead of trusting a role claim on the request.
+    function myRole() {
+      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
+    }
+
+    function isStaffUp() {
+      return isSignedIn() && myRole() in ["staff", "admin", "superadmin"];
+    }
+
+    function isAdminUp() {
+      return isSignedIn() && myRole() in ["admin", "superadmin"];
+    }
+
+    function isSuperAdmin() {
+      return isSignedIn() && myRole() == "superadmin";
+    }
+
+    /* ---------- users ----------
+       Doc ID == Firebase Auth uid (set on signup in auth.js).
+       Self-service fields: fullName, savedAddress, photoBase64, preferences.
+       role is NEVER settable by the user themselves — only a superadmin,
+       via the dashboard's User Management table. */
+    match /users/{userId} {
+      allow read: if isOwner(userId) || isStaffUp();
+
+      // Signup (auth.js / Google sign-in) always writes role: "user".
+      allow create: if isOwner(userId)
+                    && request.resource.data.role == "user";
+
+      allow update: if isSuperAdmin()
+                    || (isOwner(userId)
+                        && request.resource.data.role == resource.data.role);
+
+      allow delete: if false;
+    }
+
+    /* ---------- products ----------
+       Public storefront reads with no login (products.js loads on page
+       open, unauthenticated). Only admin/superadmin can add, edit
+       (including the confirmed stock-adjust flow), or delete. */
+    match /products/{productId} {
+      allow read: if true;
+      allow create, update, delete: if isAdminUp();
+    }
+
+    /* ---------- orders ----------
+       Every order doc carries userId (set at checkout in checkout.js).
+       Owner can read their own orders (profile.js) and cancel them
+       (profile.js — status -> "Cancelled" only, nothing else changes).
+       Staff/admin/superadmin can read and update any order (admin-orders.html),
+       EXCEPT a Cancelled order is terminal — nobody, including staff+, can
+       change it further once cancelled. */
+    match /orders/{orderId} {
+      allow read: if isSignedIn()
+                  && (resource.data.userId == request.auth.uid || isStaffUp());
+
+      allow create: if isSignedIn()
+                    && request.resource.data.userId == request.auth.uid;
+
+      allow update: if (isStaffUp() && resource.data.status != "Cancelled")
+                    || (
+                      isSignedIn()
+                      && resource.data.userId == request.auth.uid
+                      && resource.data.status != "Cancelled"
+                      && request.resource.data.status == "Cancelled"
+                      && request.resource.data.total == resource.data.total
+                      && request.resource.data.items == resource.data.items
+                    );
+
+      allow delete: if false;
+    }
+  }
+}
