+              <label class="filter-checkbox-row"><input type="checkbox" class="pf-category" value="mobility" checked /> Mobility</label>
+              <label class="filter-checkbox-row"><input type="checkbox" class="pf-category" value="wellness" checked /> Wellness</label>
+              <label class="filter-checkbox-row"><input type="checkbox" class="pf-category" value="digital" checked /> Digital Health</label>
+            </div>
+
+            <div class="filters-panel-footer">
+              <button type="button" class="filters-cancel-btn" id="productFiltersCancel">Cancel</button>
+              <button type="button" class="filters-apply-btn" id="productFiltersApply">Apply Filter</button>
+            </div>
+          </div>
+        </div>
+
+        <button type="button" class="add-product-btn product-edit-only d-none" id="addProductBtn"><i class="bi bi-plus-lg"></i> Add Product</button>
+      </div>
+
+      <div class="admin-panel" style="margin-top:24px;">
+        <h4>All Products</h4>
+        <table class="admin-table" id="adminProductsTable">
+          <thead>
+            <tr><th></th><th>Name</th><th>Category</th><th>Price</th><th>Stock</th><th>Status</th><th>Last Updated</th><th></th></tr>
+          </thead>
+          <tbody>
+            <tr><td colspan="8" class="text-center text-muted py-4">Loading...</td></tr>
+          </tbody>
+        </table>
+      </div>
+    </main>
+  </div>
+
+  <!-- Add / Edit Product modal — was previously a permanent card between the
+       toolbar and the table; moved into a modal so the table gets the full
+       width, matching the reference layout. -->
+  <div class="modal fade" id="productModal" tabindex="-1" aria-labelledby="productFormTitle" aria-hidden="true">
+    <div class="modal-dialog modal-dialog-centered">
+      <div class="modal-content">
+        <div class="modal-header">
+          <h5 class="modal-title" id="productFormTitle">Add Product</h5>
+          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
+        </div>
+        <div class="modal-body">
+          <form class="admin-form" id="productForm">
+            <input type="hidden" id="productEditingId" />
+            <input type="text" id="pName" placeholder="Product name" required />
+            <select id="pCategory" required>
+              <option value="mobility">Mobility</option>
+              <option value="wellness">Wellness</option>
+              <option value="digital">Digital Health</option>
+            </select>
+            <input type="text" id="pSubcategory" placeholder="Subcategory (e.g. Walking Aids)" />
+            <input type="number" id="pPrice" placeholder="Price (PHP)" min="0" required />
+            <input type="number" id="pStock" placeholder="Stock quantity" min="0" />
+            <div class="stock-inline-adjust d-none" id="stockInlineAdjustWrap">
+              <p class="stock-input-disabled-hint mb-0" style="margin-top:0;">Stock is locked while editing.</p>
+              <button type="button" class="stock-inline-adjust-btn" id="stockInlineAdjustBtn"><i class="bi bi-plus-slash-minus"></i> Adjust Stock</button>
+            </div>
+
+            <input type="hidden" id="pImg" />
+            <input type="hidden" id="pImgBase64" />
+            <div class="image-drop-preview d-none" id="imagePreviewWrap">
+              <img id="imagePreview" src="" alt="Product preview" />
+              <button type="button" class="remove-image-btn" id="removeImageBtn" title="Remove image"><i class="bi bi-x"></i></button>
+            </div>
+            <div class="image-drop-zone" id="imageDropZone">
+              <i class="bi bi-cloud-arrow-up"></i>
+              <p>Drag &amp; drop a photo, or click to browse</p>
+              <p class="drop-hint-small">JPG or PNG, resized automatically</p>
+            </div>
+            <input type="file" id="imageFileInput" accept="image/*" class="d-none" />
+
+            <button type="submit" class="btn-success w-100">Save Product</button>
+          </form>
+        </div>
+      </div>
+    </div>
+  </div>
+
+  <!-- Stock Adjustment Modal — two-step: edit quantity, then confirm the change.
+       Added per instructor feedback: stock edits previously committed instantly
+       with no warning, which could let a drastic/accidental change through
+       unnoticed. This forces an explicit "are you sure" before anything writes
+       to Firestore. -->
+  <div class="modal fade" id="stockModal" tabindex="-1" aria-labelledby="stockModalTitle" aria-hidden="true">
+    <div class="modal-dialog modal-dialog-centered">
+      <div class="modal-content">
+        <div class="modal-header">
+          <h5 class="modal-title" id="stockModalTitle">Adjust Stock</h5>
+          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
+        </div>
+
+        <!-- Step 1: enter the new quantity -->
+        <div class="modal-body" id="stockStepEdit">
+          <p class="stock-modal-product" id="stockProductName">—</p>
+          <p class="stock-modal-current">Current stock: <strong id="stockCurrentQty">—</strong></p>
+          <label for="stockNewQty" class="stock-modal-label">New quantity</label>
+          <input type="number" id="stockNewQty" class="stock-modal-input" min="0" step="1" required />
+        </div>
+
+        <!-- Step 2: confirm the change before it's written -->
+        <div class="modal-body d-none" id="stockStepConfirm">
+          <p class="stock-modal-product">Change stock for <strong id="confirmProductName">—</strong>?</p>
+          <div class="stock-confirm-diff">
+            <span id="confirmOldQty">—</span>
+            <i class="bi bi-arrow-right"></i>
+            <span id="confirmNewQty">—</span>
+          </div>
+          <p class="stock-confirm-warning d-none" id="confirmWarning"></p>
+        </div>
+
+        <div class="modal-footer">
+          <button type="button" class="stock-modal-btn-secondary" data-bs-dismiss="modal">Cancel</button>
+          <button type="button" class="stock-modal-btn-secondary d-none" id="stockBackBtn">Go Back</button>
+          <button type="button" class="btn-success" id="stockContinueBtn">Continue</button>
+          <button type="button" class="btn-success d-none" id="stockConfirmBtn">Confirm Change</button>
+        </div>
+      </div>
+    </div>
+  </div>
+
+  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
+  <script type="module" src="../js/firebase.js"></script>
+  <script type="module" src="../js/admin.js"></script>
+</body>
+</html>
